{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["sin1"],
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node",
      "config": {
        "helpers": false,
        "includeFiles": ["public/**"]
      }
    }
  ],
  "routes": [{ "src": "/(.*)", "dest": "/api/index.js" }],
  "crons": [{ "path": "/api/cron/cleanup", "schedule": "0 16 * * *" }]
}
