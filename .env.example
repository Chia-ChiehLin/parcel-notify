# 複製成 .env.local 給本機開發用（npm run dev）。
# 正式環境的值請設定在 Vercel → Settings → Environment Variables，不要放進 Git。

# Postgres 連線字串（Vercel 的 Neon 整合會自動提供 DATABASE_URL）
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# 主金鑰：簽章住戶連結、加密 LINE 金鑰用。至少 32 字元，產生方式：openssl rand -hex 32
# ⚠️ 設定後不要更改，否則已發出的住戶連結會失效、已儲存的自有 LINE 金鑰會無法解密
APP_SECRET=

# 第一次部署後建立平台管理員用的設定碼（至少 16 字元）。建立完成後可以刪除
SETUP_TOKEN=

# Vercel Cron 每日排程的密碼（Vercel 會自動帶在請求裡）
CRON_SECRET=

# 對外網址（選填，沒設定時使用 Vercel 的正式網址或 Preview 分支網址）
APP_URL=

# 產品名稱（選填，預設「樓下有件」）
BRAND_NAME=

# Email 通知（選填）：Resend 的 API key 與寄件人，使用已驗證的品牌網域寄件地址
RESEND_API_KEY=
EMAIL_FROM=

# 包裹照片儲存（選填）：在 Vercel Storage 建立 Blob store 後會自動提供
BLOB_READ_WRITE_TOKEN=

# 對外公開的服務提供者全名與客服／個資聯絡信箱
SERVICE_OPERATOR=
SUPPORT_EMAIL=
